+def _token_list(value):
+    """Normalize tokenizer output to a flat list of token ids."""
+
+    if hasattr(value, "tolist"):
+        value = value.tolist()
+    while isinstance(value, list) and value and isinstance(value[0], list):
+        value = value[0]
+    return [int(token_id) for token_id in value]
+
+
+def _find_token_subsequence(values, needle, *, start=0):
+    """Find the first occurrence of ``needle`` at or after ``start``."""
+
+    if not needle:
+        return None
+    first = max(0, start)
+    last = len(values) - len(needle)
+    if last < first:
+        return None
+    for position in range(first, last + 1):
+        if values[position : position + len(needle)] == needle:
+            return position
+    return None
+
+
+def _terminal_content_boundary(real_ids, empty_ids, content_ids):
+    """Locate the terminal content region inside the assistant delta.
+
+    ``real_ids`` is the assistant delta (think + content + template suffix);
+    ``empty_ids`` is the same delta rendered with the content emptied.  The
+    content region starts at the unique split point ``i`` such that::
+
+        real_ids == empty_ids[:i] + content_ids + empty_ids[i:]
+
+    Zero or multiple qualifying splits mean the boundary is not provable (the
+    value may also live in reasoning), so None is returned (fail-closed).
+    Callers must never fall back to searching reasoning or the full input for
+    answer/level values.
+    """
+
+    if not content_ids:
+        return None
+    n, e, c = len(real_ids), len(empty_ids), len(content_ids)
+    # The empty delta must differ from the real delta by exactly the content.
+    if e != n - c or n < c:
+        return None
+    candidates = []
+    for i in range(e + 1):
+        if (
+            real_ids[:i] == empty_ids[:i]
+            and real_ids[i : i + c] == content_ids
+            and real_ids[i + c :] == empty_ids[i:]
+        ):
+            candidates.append(i)
+    if len(candidates) != 1:
+        return None
+    return candidates[0]
+
+
+def _answer_mask_positions(tokenizer, input_ids, content, empty_input_ids=None):
+    """Return answer/level value positions inside the terminal content region.
+
+    Only the current terminal assistant's rendered ``content`` may receive
+    answer weighting; values inside ``reasoning_content`` are never eligible.
+    The content boundary comes from the prefix rendered with the content
+    emptied (``empty_input_ids``).  When that render is unavailable, the
+    complete content token sequence is located only if it occurs exactly once
+    in the delta.  Any ambiguity returns [] (fail-closed); answer/level values
+    are never searched for in reasoning or the full input.
+    """
+
+    if not isinstance(content, str):
+        return []
+    ids = _token_list(input_ids)
+    try:
+        content_ids = _token_list(tokenizer.encode(content, add_special_tokens=False))
+    except Exception:
+        return []
+    if not content_ids:
+        return []
+
+    content_start = None
+    if empty_input_ids is not None:
+        content_start = _terminal_content_boundary(ids, _token_list(empty_input_ids), content_ids)
+    if content_start is None:
+        # Fallback: the full content encoding must occur exactly once; a
+        # second occurrence (e.g. verbatim inside think) is not provably
+        # terminal.
+        content_start = _find_token_subsequence(ids, content_ids)
+        if content_start is None:
+            return []
+        if _find_token_subsequence(ids, content_ids, start=content_start + 1) is not None:
+            return []
+
+    patterns = (
+        re.compile(r'"answer"\s*:\s*"((?:\\.|[^"\\])*)"'),
+        re.compile(r'"level"\s*:\s*"((?:\\.|[^"\\])*)"'),
+    )
+    matches = []
+    for pattern in patterns:
+        matches.extend(pattern.finditer(content))
+    matches.sort(key=lambda match: match.start(1))
+    if not matches:
+        return []
+
+    # Prefer offset mappings when available: they preserve the exact value
+    # span even when two fields have identical token ids.
+    offsets = None
+    try:
+        encoded = tokenizer(content, add_special_tokens=False, return_offsets_mapping=True)
+        encoded_ids = _token_list(encoded["input_ids"])
+        raw_offsets = encoded.get("offset_mapping")
+        if hasattr(raw_offsets, "tolist"):
+            raw_offsets = raw_offsets.tolist()
+        while isinstance(raw_offsets, list) and raw_offsets and isinstance(raw_offsets[0], list):
+            raw_offsets = raw_offsets[0]
+        if len(encoded_ids) == len(content_ids) and len(raw_offsets) == len(content_ids):
+            offsets = [(int(start), int(end)) for start, end in raw_offsets]
+    except Exception:
+        # Slow/custom tokenizers use the token-subsequence path below.
+        offsets = None
+
+    positions = []
+    if offsets is not None:
+        for match in matches:
+            for local, (start, end) in enumerate(offsets):
+                if start < match.end(1) and end > match.start(1):
+                    positions.append(content_start + local)
+        return positions
+
+    cursor = 0
+    for match in matches:
+        try:
+            value_ids = _token_list(tokenizer.encode(match.group(1), add_special_tokens=False))
+        except Exception:
+            return []
+        # The value must occur inside the content region itself; a missing
+        # value (truncated or encoding mismatch) fails closed.
+        local = _find_token_subsequence(content_ids, value_ids, start=cursor)
+        if local is None:
+            return []
+        positions.extend(range(content_start + local, content_start + local + len(value_ids)))
+        cursor = local + len(value_ids)
+    return positions
+
