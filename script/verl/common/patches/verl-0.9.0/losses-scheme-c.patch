--- a/verl/workers/utils/losses.py
+++ b/verl/workers/utils/losses.py
@@ -47,6 +47,23 @@
         # For FSDP backend, the loss is directly used for backward; while for Megatron backend,
         # the loss should be scaled by `num_microbatches` for pp schedule.
         loss = -masked_sum(log_prob_flatten, loss_mask_flatten) / batch_num_tokens * dp_size
+        # AmberFalcon patch: upweight answer tokens (scheme C) so the sparse
+        # answer signal is not drowned by format tokens.  The answer channel
+        # is intersected with the policy-loss mask (tool observations have a
+        # zero loss mask and must never contribute, even if a shifted/ragged
+        # answer channel leaks into them), and substitutes the base weight
+        # rather than adding to it.
+        answer_mask = data.get("answer_mask", None)
+        if answer_mask is not None:
+            answer_mask_flatten = answer_mask.values().float()
+            # left-shift to align with log_prob, same as loss_mask
+            answer_mask_flatten = torch.roll(answer_mask_flatten, shifts=-1, dims=0)
+            weighted_answer_mask = loss_mask_flatten * answer_mask_flatten
+            w_ans = 8.0
+            loss = -(
+                w_ans * masked_sum(log_prob_flatten, weighted_answer_mask)
+                + masked_sum(log_prob_flatten, loss_mask_flatten * (1 - answer_mask_flatten))
+            ) / batch_num_tokens * dp_size
     else:
         response_mask = data["response_mask"].to(bool)
         loss = -masked_sum(log_prob, response_mask) / batch_num_tokens * dp_size
