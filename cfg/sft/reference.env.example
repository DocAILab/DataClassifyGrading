# Reference SFT baseline recipe (example; real values are runtime-local).
#
# Purpose: ONE frozen recipe produces THE reference checkpoint. Every RL
# algorithm (GRPO / RLOO / ReMax, ...) starts from this same checkpoint so
# algorithm comparisons are never polluted by different SFT starting points.
# Legacy checkpoints produced before the canonical pipeline are not
# comparable and must be labelled `legacy/` in artifact naming.
#
# Copy to a runtime-local location, fill the placeholders, then:
#   set -a; source reference.env; set +a
#   bash script/verl/sft/run.sh "${HYDRA_OVERRIDES[@]}"
#
# HYDRA_OVERRIDES is a Bash array on purpose: quoting one multiline string
# turns every override into one Hydra key and silently breaks the recipe.

# --- runtime-local assets (never committed) ---------------------------------
DATASET_NAME=dataset
MODEL_PATH=/absolute/path/to/Qwen2.5-7B-Instruct
DATA_DIR="/absolute/path/to/sft/${DATASET_NAME}"          # exported train/val/test parquet
OUTPUT_DIR="/absolute/path/to/checkpoints/reference-${DATASET_NAME}"
PYTHON_BIN=/absolute/path/to/venv/bin/python
NUM_GPUS=1

# --- canonical pipeline provenance (recorded, not re-generated here) --------
# registry/corpus/task-config/dataset-config: runtime-local asset paths used
# by script/canonical/build + script.canonical.split before this export.
# export_report.json must show label_gap_gate=passed and per-split sha256.

# --- frozen VeRL 0.8 trainer overrides (do not tune per experiment) --------
# Keys match verl==0.8.0's sft_trainer_engine.yaml and hf_model.yaml.
HYDRA_OVERRIDES=(
  "data.train_files=$DATA_DIR/train.parquet"
  "data.val_files=$DATA_DIR/val.parquet"
  "data.messages_key=messages"
  "data.train_batch_size=32"
  "data.micro_batch_size_per_gpu=4"
  "data.max_token_len_per_gpu=8192"
  "data.max_length=8192"
  "data.truncation=error"
  "data.use_dynamic_bsz=false"
  "data.num_workers=0"
  "model.path=$MODEL_PATH"
  "model.use_remove_padding=false"
  "model.enable_gradient_checkpointing=true"
  "+model.override_config.attn_implementation=sdpa"
  "model.lora_rank=8"
  "model.lora_alpha=16"
  "model.target_modules=all-linear"
  "engine.strategy=fsdp"
  "engine.model_dtype=bfloat16"
  "engine.dtype=bfloat16"
  "engine.use_torch_compile=false"
  "optim.lr=1e-4"
  "trainer.nnodes=1"
  "trainer.n_gpus_per_node=$NUM_GPUS"
  "trainer.project_name=dataclassify-sft"
  "trainer.experiment_name=reference-${DATASET_NAME}"
  "trainer.default_local_dir=$OUTPUT_DIR/checkpoints"
  'trainer.logger=["console"]'
  "trainer.resume_mode=disable"
  "trainer.resume_from_path=null"
  "trainer.save_freq=50"
  "trainer.max_ckpt_to_keep=4"
  "trainer.test_freq=-1"
  "trainer.total_epochs=4"
)
