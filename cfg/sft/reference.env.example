# Reference SFT baseline recipe (example; real values are runtime-local).
#
# Purpose: ONE frozen recipe produces THE reference checkpoint. Every RL
# algorithm (GRPO / RLOO / ReMax, ...) starts from this same checkpoint so
# algorithm comparisons are never polluted by different SFT starting points.
# Legacy checkpoints produced before the canonical pipeline are not
# comparable and must be labelled `legacy/` in artifact naming.
#
# Copy to a runtime-local location, fill the placeholders, then:
#   set -a; source reference.env; set +a
#   bash script/verl/sft/run.sh <hydra overrides below>

# --- runtime-local assets (never committed) ---------------------------------
MODEL_PATH=/absolute/path/to/Qwen2.5-7B-Instruct
DATA_DIR=/absolute/path/to/sft/<dataset>          # parquet from script/verl/sft/export.py
OUTPUT_DIR=/absolute/path/to/checkpoints/reference-<dataset>
PYTHON_BIN=/absolute/path/to/venv/bin/python
NUM_GPUS=1

# --- canonical pipeline provenance (recorded, not re-generated here) --------
# registry/corpus/task-config/dataset-config: runtime-local asset paths used
# by script/canonical/build + script.canonical.split before this export.
# export_report.json must show label_gap_gate=passed and per-split sha256.

# --- frozen trainer overrides (do not tune per experiment) ------------------
HYDRA_OVERRIDES="
  data.train_batch_size=32 \
  data.max_length=4096 \
  optim.lr=1e-4 \
  trainer.total_epochs=4 \
  trainer.save_freq=50 \
  trainer.max_ckpt_keep=4 \
  model.partial_params.num_loop=1 \
  model.lora.rank=8 \
  model.lora.alpha=16 \
  model.lora.target_modules=all-linear \
  model.override_config.attn_implementation=sdpa \
  model.use_remove_padding=false \
  engine.model_dtype=bfloat16 \
  trainer.gradient_checkpointing=true
"
