# ---- Repository data policy ----
# Only data/README.md and data/knowledge/**/*.json may be tracked under data/.
/data/**
!/data/README.md
!/data/knowledge/
!/data/knowledge/**/
!/data/knowledge/**/*.json

# Production task assets and generated results are always runtime-local.
/cfg/task/corpus/
/cfg/task/registry/
/artifacts/
/.artifacts/
/local-assets/
/runtime-assets/
/tmp/
/models/
/wandb/


# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Windows / macOS ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- 密钥与本地配置 ----
.env
.env.*
*.pem
*.key

# ---- Local agent subagent configs (runtime-local, not committed) ----
.pi/
